# =============================================================================
# 广厦心安 zhongjian_site · 环境变量模板（可提交）
# 复制为下列之一后按环境填写（这些真实文件已被 gitignore）：
#   .env.local | .env.dev | .env.test | .env.prod
#
# 启动示例：
#   ./scripts/corp-with-env.sh dev npm run build
#   ./scripts/corp-with-env.sh dev ./scripts/corp-start.sh
#
# 说明：本项目是 Next.js。VITE_API_BASE_URL 为统一命名约定，
# 运行时会映射为测评 API 根地址（等同 ASSESSMENT_API_BASE_URL）。
# 详见 ENVIRONMENTS.md
# =============================================================================

# local | dev | test | prod
CORP_ENV=dev
# 浏览器可见，用于右上角环境角标（prod 不显示）
NEXT_PUBLIC_CORP_ENV=dev

# 本环境对外 Origin（admin 生成新链接用此前缀；勿改历史已发出的 corp 链接）
# local:  https://local.corp.eap.ji-psy.com
# dev:    https://dev.corp.eap.ji-psy.com
# test:   https://test.corp.eap.ji-psy.com
# prod:   https://corp.eap.ji-psy.com
CORP_PUBLIC_ORIGIN=https://dev.corp.eap.ji-psy.com
NEXT_PUBLIC_CORP_PUBLIC_ORIGIN=https://dev.corp.eap.ji-psy.com

# 进程监听
PORT=3111
HOSTNAME=127.0.0.1
NODE_ENV=production

# -----------------------------------------------------------------------------
# API（严格按环境分离）
# VITE_API_BASE_URL：团队约定名 → 映射为测评/企业定制 API
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=http://127.0.0.1:19000
# 下列与 VITE_API_BASE_URL 保持一致即可（可显式写出便于核对）
ASSESSMENT_API_BASE_URL=http://127.0.0.1:19000
MINI_API_BASE_URL=http://127.0.0.1:19000
MINI_PUBLIC_BASE_URL=https://dev.eap.ji-psy.com
BACKEND_ENV=eap

# 咨询师
USE_REAL_COUNSELORS=true
COUNSELORS_FETCH_LIMIT=4
COUNSELORS_LIST_FETCH_LIMIT=50
